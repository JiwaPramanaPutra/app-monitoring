# Salin file ini menjadi `.env` lalu isi nilainya.
# File `.env` tidak pernah ikut ke Git — hanya `.env.example` ini yang masuk repo.

# Port backend
PORT=3000

# MongoDB (opsional).
# Kosongkan untuk mode penyimpanan JSON lokal di `backend/data/`.
# Contoh lokal     : mongodb://127.0.0.1:27017/nadi
# Contoh Docker    : mongodb://mongo:27017/nadi
MONGO_URI=

# === Auth (WAJIB) ===
# Backend menolak start bila JWT_SECRET atau ADMIN_PASSWORD kosong.
# Generate JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Akun viewer (role Client, hanya-baca) — opsional.
VIEWER_USERNAME=
VIEWER_PASSWORD=

# === MikroTik (opsional) ===
# Fallback global untuk site yang belum punya routerConfig sendiri.
# Cara yang disarankan: isi konfigurasi per-site lewat halaman Project & Site.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_INTERFACE=ether1
MIKROTIK_TIMEOUT=3
# Port yang ditampilkan di UI (mis. port WinBox), opsional.
MIKROTIK_DISPLAY_PORT=

# === Telegram (opsional) ===
# Notifikasi offline/online perangkat. Verifikasi dengan: npm run telegram:test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
